      "paramStructure": "by-position",
      "params": [
        {
          "name": "settings",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/PartialTournamentSettings"
          },
          "description": "Missing settings take the defaults."
        },
        {
          "name": "parts",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "ledger": {
                "$ref": "#/components/schemas/Ledger"
              },
              "schedule": {
                "$ref": "#/components/schemas/Schedule"
              },
              "seating": {
                "$ref": "#/components/schemas/Seats"
              }
            },
            "required": [
              "ledger",
              "schedule",
              "seating"
            ],
            "additionalProperties": false
          }
        }
      ],
      "result": {
        "name": "tournament",
        "schema": {
          "$ref": "#/components/schemas/Tournament"
        }
      },
      "errors": [
        {
          "$ref": "#/components/errors/BadStacks"
        },
        {
          "$ref": "#/components/errors/BadCounts"
        },
        {
          "$ref": "#/components/errors/BadTiebreak"
        }
      ],
      "tags": [
        {
          "name": "server"
        }
      ]
    },
