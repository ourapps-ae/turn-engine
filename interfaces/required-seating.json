      "paramStructure": "by-position",
      "params": [
        {
          "name": "settings",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/PartialSeatingSettings"
          },
          "description": "Missing settings take the defaults."
        },
        {
          "name": "identity",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Identity"
          }
