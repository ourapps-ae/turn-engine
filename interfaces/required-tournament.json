  "components": {
    "schemas": {
      "TournamentSettings": {
        "type": "object",
        "properties": {
          "startingStack": {
            "type": "integer",
            "minimum": 1,
            "default": 5000,
            "description": "Every entry is issued this through the ledger; chip-ledger's own startingStack is not read."
          },
          "rebuysPerPlayer": {
            "type": "integer",
            "minimum": 0,
            "default": 1
          },
          "rebuyStack": {
            "type": "integer",
            "minimum": 1,
            "default": 5000
          },
          "lastRebuyLevel": {
            "type": "integer",
            "minimum": 0,
            "default": 3,
            "description": "A rebuy is offered only when the level a round was dealt at is at most this."
          },
          "rebuyDecisionSeconds": {
            "type": "integer",
            "minimum": 1,
            "default": 30
          },
          "tiebreak": {
            "type": "string",
            "enum": [
              "stackAtDeal",
              "shared"
            ],
            "default": "stackAtDeal",
            "description": "Entries out in the same round place by their stack at the deal, or share one place."
          }
        },
        "required": [
          "startingStack",
          "rebuysPerPlayer",
          "rebuyStack",
          "lastRebuyLevel",
          "rebuyDecisionSeconds",
          "tiebreak"
        ],
        "additionalProperties": false
