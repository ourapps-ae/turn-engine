{
  "id": "presence",
  "type": "ae/presence",
  "version": "1.0.0",
  "notes": "What the engine needs from the presence component (seen, live connection, away, sitting out, missed turns, pauses, holds). State is opaque and lives under `presence`. Operations that change nothing MUST return the same object they were given (the engine compares by identity for seen, setHold). refresh applies the silence rule (a person not live and not heard from for the presence time counts as disconnected), drops holds that no longer apply, and recomputes the automatic pauses from the host and the people still in the game.",
  "operations": {
    "create": {
      "arguments": [],
      "returns": "PresenceState"
    },
    "register": {
      "arguments": [
        "state",
        "id",
        "now",
        "kind:person|computer"
      ],
      "returns": "PresenceState"
    },
    "unregister": {
      "arguments": [
        "state",
        "id"
      ],
      "returns": "PresenceState"
    },
    "restart": {
      "arguments": [
        "state",
        "keepIds:string[]"
      ],
      "returns": "PresenceState (new game or lobby: keep these, sitting out and misses cleared, no pauses or holds)"
    },
    "seen": {
      "arguments": [
        "state",
        "id",
        "now"
      ],
      "returns": "PresenceState (same object when nothing changes)"
    },
    "setLive": {
      "arguments": [
        "state",
        "id",
        "live:boolean",
        "now"
      ],
      "returns": "PresenceState"
    },
    "away": {
      "arguments": [
        "state",
        "id"
      ],
      "returns": "PresenceState"
    },
    "sitOut": {
      "arguments": [
        "state",
        "id"
      ],
      "returns": "PresenceState"
    },
    "returned": {
      "arguments": [
        "state",
        "id",
        "now"
      ],
      "returns": "PresenceState (sitting out and misses cleared, connected)"
    },
    "leftGame": {
      "arguments": [
        "state",
        "id"
      ],
      "returns": "PresenceState (sitting out and disconnected)"
    },
    "recordMiss": {
      "arguments": [
        "state",
        "id"
      ],
      "returns": "PresenceState"
    },
    "isConnected": {
      "arguments": [
        "state",
        "id"
      ],
      "returns": "boolean"
    },
    "isLive": {
      "arguments": [
        "state",
        "id"
      ],
      "returns": "boolean"
    },
    "isSittingOut": {
      "arguments": [
        "state",
        "id"
      ],
      "returns": "boolean"
    },
    "misses": {
      "arguments": [
        "state",
        "id"
      ],
      "returns": "number"
    },
    "lastSeen": {
      "arguments": [
        "state",
        "id"
      ],
      "returns": "number"
    },
    "refresh": {
      "arguments": [
        "state",
        "now",
        "context:{hostId:string|null,running:boolean,roundOver:boolean,activeIds:string[]}"
      ],
      "returns": "PresenceState"
    },
    "setManualPause": {
      "arguments": [
        "state",
        "on:boolean",
        "now:number"
      ],
      "returns": "PresenceState (now is when the pause began or ended)"
    },
    "setHold": {
      "arguments": [
        "state",
        "id",
        "kind:look|learn|null",
        "context:{running:boolean,roundOver:boolean}"
      ],
      "returns": "PresenceState"
    },
    "isPaused": {
      "arguments": [
        "state"
      ],
      "returns": "boolean (hostAbsent, allOffline or manual)"
    },
    "pauseReasons": {
      "arguments": [
        "state"
      ],
      "returns": "string[] of hostAbsent, allOffline, manual"
    },
    "isManualPause": {
      "arguments": [
        "state"
      ],
      "returns": "boolean"
    },
    "pausedSince": {
      "arguments": [
        "state"
      ],
      "returns": "number|null (wall time the table first paused)"
    },
    "isHeld": {
      "arguments": [
        "state"
      ],
      "returns": "boolean"
    },
    "holds": {
      "arguments": [
        "state"
      ],
      "returns": "{playerId,kind}[]"
    },
    "nextWake": {
      "arguments": [
        "state"
      ],
      "returns": "number|null (wall time the next silence rule falls due)"
    }
  }
}
