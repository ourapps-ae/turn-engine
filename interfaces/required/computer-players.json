{
  "id": "computer-players",
  "type": "ae/computer-players",
  "version": "1.0.0",
  "notes": "The subset of the computer-players component's provided interface (components/computer-players/interfaces/computer-players.json) the engine calls. Its state lives under `computers`. The port is optional in the manifest: a design without computer players leaves it unconnected, and an engine built without `computers` uses implementation/server/no-computers.ts.",
  "operations": {
    "create": {
      "arguments": [],
      "returns": "ComputersState"
    },
    "forget": {
      "arguments": [],
      "returns": "ComputersState"
    },
    "idFor": {
      "arguments": [
        "name"
      ],
      "returns": "string"
    },
    "add": {
      "arguments": [
        "seats",
        "byId"
      ],
      "returns": "Outcome with name"
    },
    "fill": {
      "arguments": [
        "seats"
      ],
      "returns": "{state,added:string[]}"
    },
    "actsFor": {
      "arguments": [
        "seats",
        "player:{id,connected,sittingOut}"
      ],
      "returns": "boolean"
    },
    "moveDeadline": {
      "arguments": [
        "clock",
        "settleUntilMs",
        "rng"
      ],
      "returns": "number"
    },
    "isDue": {
      "arguments": [
        "clock",
        "deadlineMs"
      ],
      "returns": "boolean"
    },
    "rebuyDelayMs": {
      "arguments": [],
      "returns": "number"
    },
    "choose": {
      "arguments": [
        "state",
        "observation",
        "playerId",
        "rng"
      ],
      "returns": "{move|null,state}"
    },
    "observe": {
      "arguments": [
        "state",
        "observation",
        "playerId",
        "move"
      ],
      "returns": "ComputersState"
    }
  }
}
